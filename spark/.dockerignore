# Keep the build context minimal and free of secrets/local state.
.git
.gitignore
**/__pycache__
**/*.py[cod]
**/.pytest_cache
.venv
**/.env
**/.env.*
**/*.env
**/secrets
**/*.pem
**/*.key
**/*.tfstate*
**/*.tfvars
.dockerignore
Dockerfile
# Local Spark output that must never be baked into the image
**/checkpoints
**/spark-warehouse
**/data
**/metastore_db
**/derby.log
