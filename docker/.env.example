# Copy to docker/.env and fill in. Never commit docker/.env.
# Generate values with: openssl rand -hex 24
POSTGRES_PASSWORD=
DEBEZIUM_PASSWORD=
GENERATOR_PASSWORD=

# Optional generator tuning
# GENERATOR_RATE=1
# GENERATOR_TIME_SCALE=60

# Salt for hashing customer emails in silver. Changing it breaks joins on email_hash.
PII_HASH_SALT=

# Airflow (fernet key: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET=
AIRFLOW_JWT_SECRET=
# The Airflow UI password is NOT an env var: it lives in docker/secrets/airflow_passwords.json
# (see the airflow service in compose.yaml for how to create it).
