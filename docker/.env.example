# Copy to docker/.env and fill in. Never commit docker/.env.
# Generate values with: openssl rand -hex 24
POSTGRES_PASSWORD=
DEBEZIUM_PASSWORD=
GENERATOR_PASSWORD=

# Optional generator tuning
# GENERATOR_RATE=1
# GENERATOR_TIME_SCALE=60

# Salt for hashing customer emails in silver. Changing it breaks joins on email_hash.
PII_HASH_SALT=
